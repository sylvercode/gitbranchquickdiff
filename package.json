{
  "name": "gitbranchquickdiff",
  "displayName": "GitBranchQuickDiff",
  "description": "",
  "publisher": "sylvercode",
  "repository": {
    "url": "https://github.com/sylvercode/gitbranchquickdiff"
  },
  "version": "0.2.1",
  "enabledApiProposals": [
    "quickDiffProvider"
  ],
  "engines": {
    "vscode": "^1.107.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Branch Quick Diff",
      "properties": {
        "gitbranchquickdiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use Git Branch Quick Diff as diff gutter instead of VSCode default. The file of the ref will be use as base for the comparison."
        },
        "gitbranchquickdiff.ref": {
          "type": "string",
          "default": "main",
          "description": "Name of the ref to use for comparison. Variables substitution can be use."
        },
        "gitbranchquickdiff.displayMode": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "default": "list",
          "description": "Display mode for the changes view: list or tree."
        },
        "gitbranchquickdiff.defaultAction": {
          "type": "string",
          "enum": [
            "openChanges",
            "openFile"
          ],
          "default": "openChanges",
          "description": "Default action when clicking on a changed file: open diff (openChanges) or open file directly (openFile)."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "gitbranchquickdiff.changes",
          "name": "Quick Diff",
          "icon": "$(git-branch)",
          "contextualTitle": "Quick Diff Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "gitbranchquickdiff.activate",
        "title": "Activate GitBranchQuickDiff",
        "enablement": "!config.gitbranchquickdiff.enabled"
      },
      {
        "command": "gitbranchquickdiff.changeref",
        "title": "Set quick diff ref",
        "icon": "$(target)"
      },
      {
        "command": "gitbranchquickdiff.defaultref",
        "title": "Revert quick diff ref to user setting"
      },
      {
        "command": "gitbranchquickdiff.deactivate",
        "title": "Deactivate GitBranchQuickDiff",
        "enablement": "config.gitbranchquickdiff.enabled"
      },
      {
        "command": "gitbranchquickdiff.refreshChanges",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitbranchquickdiff.openChange",
        "title": "Open Changes",
        "icon": "$(compare-changes)"
      },
      {
        "command": "gitbranchquickdiff.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitbranchquickdiff.viewAsList",
        "title": "View as List",
        "icon": "$(check)"
      },
      {
        "command": "gitbranchquickdiff.viewAsTree",
        "title": "View as Tree",
        "icon": "$(check)"
      },
      {
        "command": "gitbranchquickdiff.setDefaultActionOpenFile",
        "title": "Open File by Default"
      },
      {
        "command": "gitbranchquickdiff.setDefaultActionOpenChanges",
        "title": "Open Changes by Default"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitbranchquickdiff.changeref",
          "when": "view == gitbranchquickdiff.changes && config.gitbranchquickdiff.enabled",
          "group": "navigation"
        },
        {
          "command": "gitbranchquickdiff.refreshChanges",
          "when": "view == gitbranchquickdiff.changes && config.gitbranchquickdiff.enabled",
          "group": "navigation"
        },
        {
          "command": "gitbranchquickdiff.viewAsList",
          "when": "view == gitbranchquickdiff.changes && gitbranchquickdiff.displayMode == tree && config.gitbranchquickdiff.enabled",
          "group": "1_displaymode"
        },
        {
          "command": "gitbranchquickdiff.viewAsTree",
          "when": "view == gitbranchquickdiff.changes && gitbranchquickdiff.displayMode == list && config.gitbranchquickdiff.enabled",
          "group": "1_displaymode"
        },
        {
          "command": "gitbranchquickdiff.setDefaultActionOpenFile",
          "when": "view == gitbranchquickdiff.changes && config.gitbranchquickdiff.defaultAction != openFile && config.gitbranchquickdiff.enabled",
          "group": "3_defaultaction@1"
        },
        {
          "command": "gitbranchquickdiff.setDefaultActionOpenChanges",
          "when": "view == gitbranchquickdiff.changes && config.gitbranchquickdiff.defaultAction != openChanges && config.gitbranchquickdiff.enabled",
          "group": "3_defaultaction@2"
        },
        {
          "command": "gitbranchquickdiff.activate",
          "when": "view == gitbranchquickdiff.changes && !config.gitbranchquickdiff.enabled",
          "group": "4_activation@1"
        },
        {
          "command": "gitbranchquickdiff.deactivate",
          "when": "view == gitbranchquickdiff.changes && config.gitbranchquickdiff.enabled",
          "group": "4_activation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitbranchquickdiff.openChange",
          "when": "view == gitbranchquickdiff.changes && viewItem =~ /^changedFile:/ && config.gitbranchquickdiff.defaultAction != openChanges && config.gitbranchquickdiff.enabled",
          "group": "inline@1"
        },
        {
          "command": "gitbranchquickdiff.openFile",
          "when": "view == gitbranchquickdiff.changes && viewItem =~ /^changedFile:/ && config.gitbranchquickdiff.defaultAction != openFile && config.gitbranchquickdiff.enabled",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "eslint": "^9.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
